[Unit]
Description=Geluidsmeter — FastAPI service (poort 8792)
After=network.target

[Service]
User=bob
WorkingDirectory=/home/bob/LeefomgevingLab
Environment=GELUIDSMETER_CONFIG_PATH=/home/bob/LeefomgevingLab/core/config.yaml
ExecStart=/home/bob/LeefomgevingLab/.venv/bin/uvicorn leefomgevinglab.geluidsmeter.api:app --host 0.0.0.0 --port 8792 --app-dir src
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
