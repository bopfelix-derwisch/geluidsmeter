[Unit]
Description=Geluidsmeter — audio capture + feature extract loop
After=network.target

[Service]
User=bob
WorkingDirectory=/home/bob/Geluidsmeter
Environment=GELUIDSMETER_CONFIG_PATH=/home/bob/Geluidsmeter/core/config.yaml
ExecStart=/home/bob/Geluidsmeter/.venv/bin/python3 -c "from geluidsmeter.audio_capture import run_capture_loop; run_capture_loop()"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
