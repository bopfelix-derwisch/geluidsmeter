[Unit]
Description=LeefomgevingLab — Cloudflare Tunnel (geluid.felixisfelix.com)
After=network-online.target leefomgevinglab-api.service
Wants=network-online.target
Requires=leefomgevinglab-api.service

[Service]
User=bob
ExecStart=/usr/local/bin/cloudflared tunnel --config /home/bob/.cloudflared/config.yml run
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
